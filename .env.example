# ============================================================
# AYYAJ KALANDAR SHAIKH — DEVELOPER PORTFOLIO ENVIRONMENT CONFIG
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

VITE_APP_TITLE=Ayyaj Kalandar Shaikh — Personal Developer Platform

# ------------------------------------------------------------
# Supabase Cloud Project Configuration  (required)
# Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------
# Admin email hint
# Used when a bare username (without @) is entered on the login page.
# Authentication itself is handled entirely by Supabase Auth.
# ------------------------------------------------------------
VITE_ADMIN_EMAIL=ayyajahmad64@gmail.com

# ------------------------------------------------------------
# Optional: External AI Chat Proxy Endpoint
# Point this at your own backend proxy that holds the AI provider key.
# NEVER put an AI provider API key directly in a VITE_ variable.
# If not set, JARVIS will use the built-in local knowledge engine.
# ------------------------------------------------------------
# VITE_AI_CHAT_ENDPOINT=https://your-backend-proxy.com/api/chat
